# Скопіюйте цей файл у .env і заповніть. .env не комітьте.

# Провайдер за замовчуванням: Groq (безкоштовний). Ключ: https://console.groq.com (розділ API Keys).
# Без ключа утиліта працює в режимі mock (шаблонні варіанти без моделі).
GROQ_API_KEY=your_groq_api_key_here

# Необов'язково: назви моделей. Якщо не задано, беруться значення з коду.
# Якщо обидві моделі недоступні, провайдер сам вибере доступну з https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Необов'язково: будь-який OpenAI-сумісний провайдер замість Groq.
# Якщо задано LLM_BASE_URL і LLM_API_KEY, Groq-змінні ігноруються.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=model-name
# LLM_FALLBACK_MODEL=
# LLM_LABEL=openrouter

